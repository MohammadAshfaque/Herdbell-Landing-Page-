---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Herdbell — Every Agent. One Place.',
  description = 'Herdbell is a lightweight macOS menu bar app to monitor, control, and switch between AI coding agents from a single popup at your cursor.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Herdbell — Every Agent. One Place. Zero Context Lost." />
    <meta property="og:description" content="Monitor, approve, reply to, and hand off Claude Code, Codex, Cursor and Antigravity sessions from a popup at your cursor." />
    <meta name="theme-color" content="#0b0b0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
